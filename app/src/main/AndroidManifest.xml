<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- DirCon to Grupetto on this tablet (127.0.0.1), intervals.icu, Strava, and the "Send to the bike" page. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- The floating workout panel. -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <!-- Keeps the panel (and the ride) running while another app is in front. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- "Start on boot" (main screen): open the panel when the tablet starts. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- Android 11+: lets Gregario see whether Grupetto is installed, and open it (the "No bike found" card). -->
    <queries>
        <package android:name="com.spop.poverlay" />
    </queries>

    <application
        android:name="com.madooroy.gregario.GregarioApp"
        android:allowBackup="false"
        android:icon="@drawable/ic_launcher"
        android:roundIcon="@drawable/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Gregario"
        tools:targetApi="34">

        <activity
            android:name="com.madooroy.gregario.ui.MainActivity"
            android:exported="true"
            android:launchMode="singleTask">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- "Connect intervals.icu": intervals.icu's sign-in page inside Gregario (no browser on the Peloton). -->
        <activity
            android:name="com.madooroy.gregario.ui.IcuSignInActivity"
            android:exported="false"
            android:excludeFromRecents="true" />

        <!-- "Open with" / "Share to" for workout files (.zwo, .mrc, .erg). Workout files arrive with unhelpful
             MIME types, so the filters are broad and the activity checks the content. -->
        <activity
            android:name="com.madooroy.gregario.ui.ImportWorkoutActivity"
            android:exported="true"
            android:label="Gregario workout"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:theme="@android:style/Theme.Translucent.NoTitleBar">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="content" />
                <data android:mimeType="application/octet-stream" />
                <data android:mimeType="application/xml" />
                <data android:mimeType="text/xml" />
                <data android:mimeType="text/plain" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <!-- Files and text only (was */*: Gregario was offered for photos and videos too). Any file type,
                     since mail and Drive name .zwo/.mrc/.erg files differently. -->
                <data android:mimeType="application/*" />
                <data android:mimeType="text/*" />
            </intent-filter>
        </activity>

        <service
            android:name="com.madooroy.gregario.ui.PanelService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Floating workout panel that runs a structured indoor-cycling workout" />
        </service>

        <receiver
            android:name="com.madooroy.gregario.ui.BootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>
        <!-- "Share ride file" on the finish screen: the ride's .fit, lent to the chosen app (read only, this file only). -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.share"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/share_paths" />
        </provider>
    </application>

</manifest>
