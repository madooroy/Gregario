<workout_file>
  <author>Gregario test workout</author>
  <name>Threshold 3x10</name>
  <description>3 x 10 min at 95% FTP, 5-min recoveries.</description>
  <sportType>bike</sportType>
  <workout>
    <Ramp Duration="600" PowerLow="0.45" PowerHigh="0.70"/>
    <IntervalsT Repeat="3" OnDuration="600" OffDuration="300" OnPower="0.95" OffPower="0.50"/>
    <Ramp Duration="300" PowerLow="0.50" PowerHigh="0.40"/>
  </workout>
</workout_file>
