<workout_file>
  <author>Gregario test workout</author>
  <name>VO2 15x30</name>
  <description>3 sets of 5 x 30 s at 115% FTP.</description>
  <sportType>bike</sportType>
  <workout>
    <SteadyState Duration="420" Power="0.55"/>
    <IntervalsT Repeat="5" OnDuration="30" OffDuration="30" OnPower="1.15" OffPower="0.55"/>
    <SteadyState Duration="180" Power="0.40"/>
    <IntervalsT Repeat="5" OnDuration="30" OffDuration="30" OnPower="1.15" OffPower="0.55"/>
    <SteadyState Duration="180" Power="0.40"/>
    <IntervalsT Repeat="5" OnDuration="30" OffDuration="30" OnPower="1.15" OffPower="0.55"/>
    <Ramp Duration="120" PowerLow="0.45" PowerHigh="0.35"/>
  </workout>
</workout_file>
